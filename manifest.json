{
  "manifest_version": 3,
  "name": "Text Hunter",
  "version": "1.3.1",
  "author": { "email": "pranto.smss.dev@gmail.com" },
  "homepage_url": "https://github.com/prantosmss/TextHunter",
  "description": "Floating panel: pick a list on any page, then scrape every linked page's heading and paragraphs into one Markdown file.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
